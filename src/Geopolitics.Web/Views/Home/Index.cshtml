@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-4">
    <canvas id="lineup" class="lineup" width="764" height="150" role="img" aria-label="Ten soldiers in different uniforms, each with the flag of a country above their head"></canvas>
    <h1 class="display-4">Geopolitics</h1>
    <p class="lead">Take on nine rival nations and conquer the world, one dice roll at a time.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary btn-lg me-2" asp-controller="Game" asp-action="New">Start a new game</a>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Game" asp-action="My">My games</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Register">Sign up to play</a>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
    }

    <p class="text-muted mt-4">Anyone with a game's link can watch it live. Only its owner can play.</p>
</div>

@section Scripts {
    <script type="module" src="~/js/home.js" asp-append-version="true"></script>
}
