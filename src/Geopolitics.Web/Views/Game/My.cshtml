@model List<Geopolitics.Data.Models.GameDoc>
@{
    ViewData["Title"] = "My games";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My games</h1>
    <a class="btn btn-primary" asp-action="New">New game</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">You have not played any games yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Started (UTC)</th><th>Status</th><th>Round</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var game in Model)
            {
                <tr>
                    <td>@game.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@game.Status</td>
                    <td>@game.Round</td>
                    <td class="text-end"><a asp-controller="Game" asp-action="Details" asp-route-id="@game.Id">Open</a></td>
                </tr>
            }
        </tbody>
    </table>
}
