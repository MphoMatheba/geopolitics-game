@model string
@{
    ViewData["Title"] = "Game";
}

@* The game page. All behaviour lives in wwwroot/js/game/ (page.js drives it);
   this file is only the layout. *@

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />

<div id="app" data-game-id="@Model">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
        <div>
            <h1 class="h4 mb-0">Geopolitics</h1>
            <div id="status" class="text-muted">Loading...</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button id="ff" type="button" class="btn btn-sm btn-outline-warning d-none">&#9193; Fast-forward</button>
            <span id="role" class="badge bg-secondary">Loading...</span>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-8">
            <div id="stage">
                <div id="globe"></div>
                <div id="labels"></div>
                <div id="toast" role="status" aria-live="polite"></div>
                <div id="battle" class="d-none">
                    <div id="battle-title" class="fw-bold small"></div>
                    <div class="dice-row"><span class="who">Attacker</span><span id="dice-a"></span></div>
                    <div class="dice-row"><span class="who">Defender</span><span id="dice-d"></span></div>
                    <div id="dice-result" class="small"></div>
                </div>
            </div>
            <div id="narration" aria-live="polite">
                <div id="now" class="small text-muted"></div>
                <div id="why"></div>
                <div id="say"></div>
            </div>
        </div>

        <div class="col-xl-4">
            <div id="playing" class="alert alert-secondary py-2 small d-none mb-3">
                Computer players are taking their turns. You can speed this up with Fast-forward; every move is still shown.
            </div>

            <div id="controls" class="card card-body mb-3 d-none">
                <div id="msg" class="text-danger small mb-2" role="alert"></div>

                <div class="mb-3">
                    <div class="fw-bold small">Place reinforcements</div>
                    <div class="input-group input-group-sm">
                        <select id="rf-country" class="form-select" aria-label="Country to reinforce"></select>
                        <input id="rf-count" type="number" min="1" value="1" class="form-control" style="max-width:5rem" aria-label="Soldiers to place" />
                        <button id="rf-go" type="button" class="btn btn-secondary">Place</button>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="fw-bold small">Move soldiers</div>
                    <div class="input-group input-group-sm">
                        <select id="tf-from" class="form-select" aria-label="Move from"></select>
                        <select id="tf-to" class="form-select" aria-label="Move to"></select>
                        <input id="tf-count" type="number" min="1" value="1" class="form-control" style="max-width:5rem" aria-label="Soldiers to move" />
                        <button id="tf-go" type="button" class="btn btn-secondary">Move</button>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="fw-bold small">Attack <span class="text-muted fw-normal">(or click countries on the globe)</span></div>
                    <div class="input-group input-group-sm mb-2">
                        <select id="at-from" class="form-select" aria-label="Attack from"></select>
                        <select id="at-to" class="form-select" aria-label="Attack target"></select>
                    </div>
                    <button id="at-start" type="button" class="btn btn-danger btn-sm">Start attack</button>
                    <button id="at-roll" type="button" class="btn btn-warning btn-sm">Roll dice</button>
                    <button id="at-stop" type="button" class="btn btn-outline-danger btn-sm">Stop (ends turn)</button>
                </div>

                <button id="end-turn" type="button" class="btn btn-primary btn-sm">End turn</button>
            </div>

            <div class="panel mb-3">
                <h2 class="h6">Players</h2>
                <ul id="players" class="list-unstyled small mb-0"></ul>
            </div>

            <div class="panel mb-3">
                <h2 class="h6">Countries</h2>
                <table id="countries" class="table table-sm table-dark align-middle small mb-0">
                    <thead><tr><th>Country</th><th>Owner</th><th class="text-end">Soldiers</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="panel">
                <h2 class="h6">Event log</h2>
                <ul id="log" class="list-unstyled small mb-0"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="importmap">
    { "imports": { "three": "/lib/three/three.module.min.js", "three/addons/": "/lib/three/addons/" } }
    </script>
    <script type="module" src="~/js/game/page.js" asp-append-version="true"></script>
}
